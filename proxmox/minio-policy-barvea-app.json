{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::barvea-ifc", "arn:aws:s3:::barvea-ifc/*",
        "arn:aws:s3:::barvea-docs", "arn:aws:s3:::barvea-docs/*",
        "arn:aws:s3:::barvea-assets", "arn:aws:s3:::barvea-assets/*",
        "arn:aws:s3:::barvea-qr", "arn:aws:s3:::barvea-qr/*",
        "arn:aws:s3:::barvea-reports", "arn:aws:s3:::barvea-reports/*"
      ]
    }
  ]
}
