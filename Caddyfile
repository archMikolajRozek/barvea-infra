# BARVEA — Caddy 2 production config
#
# Public domains: barvea.com (apex) + www.barvea.com (canonical redirect to apex)
# TLS: auto via Let's Encrypt (HTTP-01 challenge over port 80)
# Backend: app:3005 (Next.js standalone, internal Docker network)
#
# IMPORTANT: For the FIRST deploy, uncomment the staging acme_ca line below
# to avoid hitting Let's Encrypt rate limit (5 issuances/week/domain).
# Once verified, comment it out and reload to issue a real certificate.

{
    email admin@barvea.com
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory   # ← uncomment for first run
    servers {
        protocols h1 h2 h3
        # Behind Cloudflare: trust CF edge so {client_ip} resolves to the real
        # visitor (not the CF 172.64/13 etc. edge IP). Needed for bootstrap_token
        # IP-binding at /devices/enroll. CF ranges from cloudflare.com/ips —
        # refresh if CF publishes new ranges. NOT spoofable: Caddy only trusts
        # X-Forwarded-For from these IPs; a direct-to-origin client's XFF is ignored.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        # CF puts its edge IP in X-Forwarded-For; the real visitor is in
        # Cf-Connecting-Ip. Read {client_ip} from there — only trusted because
        # the request must arrive from a trusted_proxies (CF) hop.
        client_ip_headers Cf-Connecting-Ip
    }
}

# ═══════════════════════════════════════════════════════════════
# barvea.com — primary
# ═══════════════════════════════════════════════════════════════
barvea.com {
    encode zstd gzip

    # ─── mTLS for Drive client (optional — mode=request) ───
    # Caddy requests but does NOT require a client cert. Browsers that don't
    # present one still complete the TLS handshake normally. Drive client
    # presents a device cert issued by our Vault pki_int; Caddy verifies
    # against root-ca and forwards cert metadata via headers. Per-endpoint
    # enforcement happens in the Next.js app (e.g. /api/v1/devices/* requires
    # presented cert except /enroll which accepts bootstrap_token).
    tls {
        client_auth {
            mode request
            trusted_ca_cert_file /etc/ssl/barvea/root-ca.crt
        }
    }

    # Security headers (centralised here — next.config.ts also sets some;
    # if duplicates appear in browser dev tools, remove from one side)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        # Hide upstream identification
        -Server
        -X-Powered-By
    }

    # ─── Drive machine-to-machine manifests (ACL/WG) — LAN-only ───
    # Served exclusively via app.barvea.internal (WG/LAN). Blocked here on
    # the public vhost as defense-in-depth on top of the bearer-token gate.
    # 404 (not 403) so the paths don't advertise their existence.
    @driveInternal path /api/v1/drive/* /api/v1/orgs/*/drive/*
    handle @driveInternal {
        respond 404
    }

    # ─── Signed downloads — CDE files streamed from the data-plane ───
    # /dl/<HMAC-token> — token (TTL 15 min) minted by barvea-datad via
    # GET /signed-download; self-contained, verified by the daemon.
    # Public on purpose: offloads big-file downloads from the app.
    handle /dl/* {
        reverse_proxy 10.10.0.40:8723 {
            flush_interval -1
            transport http {
                read_timeout 900s
                write_timeout 900s
                dial_timeout 10s
            }
        }
    }

    # ─── Stripe webhook: needs raw body, generous timeout ───
    handle_path /api/webhooks/* {
        reverse_proxy app:3005 {
            transport http {
                read_timeout 60s
                write_timeout 60s
            }
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ─── Long-running server work (small request, long response) ───
    # Finalizacja uploadu kawałkowego (strumień setek GB z tmp na ZFS) i build
    # tomu PDF potrafią liczyć się dziesiątki minut — default 120s je ucinał.
    @longops path \
        /api/v1/orgs/*/projects/*/documents/uploads/*/complete \
        /api/v1/orgs/*/projects/*/volumes/*/build
    handle @longops {
        request_body {
            max_size 10MB
        }
        reverse_proxy app:3005 {
            transport http {
                read_timeout 7200s
                write_timeout 7200s
                dial_timeout 30s
            }
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ─── Large file uploads (single-POST ≤1 GB; chunked = 32 MB per request) ───
    # UWAGA: Caddy `path /foo/*` NIE łapie gołego `/foo` — a upload CDE leci
    # POST-em na goły `.../documents`, upload IFC na goły `.../ifc`. Przez ten
    # brak requesty wpadały do domyślnego handlera z timeoutem 120 s i duże
    # pliki na wolniejszym łączu były ucinane w połowie body (Firefox:
    # "NetworkError when attempting to fetch resource").
    # `*` łapie JEDEN segment ścieżki — chunk PUT (…/documents/uploads/<id>)
    # ma dwa segmenty po /documents i potrzebuje własnego wzorca.
    @uploads path \
        /api/v1/orgs/*/projects/*/documents \
        /api/v1/orgs/*/projects/*/documents/* \
        /api/v1/orgs/*/projects/*/documents/uploads/* \
        /api/v1/orgs/*/projects/*/ifc \
        /api/v1/orgs/*/projects/*/ifc/* \
        /api/v1/orgs/*/projects/*/assets/*/documents \
        /api/v1/orgs/*/projects/*/combined-models* \
        /api/v1/plugin/projects/*/cde/upload
    handle @uploads {
        request_body {
            max_size 1GB
        }
        reverse_proxy app:3005 {
            transport http {
                read_timeout 600s
                write_timeout 600s
                dial_timeout 30s
            }
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ─── Healthcheck: exposed without rate limit (for monitoring) ───
    handle /api/health {
        reverse_proxy app:3005 {
            transport http {
                read_timeout 10s
            }
        }
    }

    # ─── Static + everything else ───
    handle {
        # Cache Next.js immutable assets aggressively
        @nextStatic path /_next/static/*
        header @nextStatic Cache-Control "public, max-age=31536000, immutable"

        @publicStatic path /public/*
        header @publicStatic Cache-Control "public, max-age=86400"

        reverse_proxy app:3005 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}

            # mTLS cert metadata (empty if client didn't present a cert)
            header_up X-Client-Cert-Subject {tls_client_subject}
            header_up X-Client-Cert-Issuer {tls_client_issuer}
            header_up X-Client-Cert-Serial {tls_client_serial}

            # Sensible timeouts for non-upload traffic
            transport http {
                read_timeout 120s
                write_timeout 120s
                dial_timeout 10s
            }
        }
    }

    # ─── Logging ───
    log {
        output file /data/access.log {
            roll_size 100MiB
            roll_keep 14
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

# ═══════════════════════════════════════════════════════════════
# Internal WG-direct endpoint — Drive device API (sessions/start,
# policy, cde, audit). Reached ONLY over the wg-users tunnel.
# Client resolves app.barvea.internal -> 10.10.0.30 (hosts entry or
# ConnectCallback) and dials it over WG; Caddy matches on SNI.
# NOTE: do NOT add the bare IP (https://10.10.0.30) as a site address
# here — Caddy's automatic HTTPS chokes on a bare-IP site and breaks
# TLS for the whole block (tlsv1 alert internal error). Hostname only.
# Serves our pki_int cert (chains to BARVEA Root CA) so the Drive
# client's Root-CA SPKI pin matches; device mTLS forwarded, enforced
# per-endpoint in app.
# ═══════════════════════════════════════════════════════════════
https://app.barvea.internal {
    tls /etc/ssl/barvea/internal.crt /etc/ssl/barvea/internal.key {
        client_auth {
            mode request
            trusted_ca_cert_file /etc/ssl/barvea/root-ca.crt
        }
    }
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
        -X-Powered-By
    }
    reverse_proxy app:3005 {
        header_up X-Real-IP {client_ip}
        header_up Host {host}
        header_up X-Client-Cert-Subject {tls_client_subject}
        header_up X-Client-Cert-Issuer {tls_client_issuer}
        header_up X-Client-Cert-Serial {tls_client_serial}
        transport http {
            read_timeout 120s
            write_timeout 120s
            dial_timeout 10s
        }
    }
    log {
        output file /data/access-internal.log {
            roll_size 50MiB
            roll_keep 7
        }
        format json
    }
}

# ═══════════════════════════════════════════════════════════════
# www.barvea.com — 301 redirect to apex
# ═══════════════════════════════════════════════════════════════
www.barvea.com {
    redir https://barvea.com{uri} 301
}
