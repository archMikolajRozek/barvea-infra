# BARVEA — Caddy 2 production config
#
# Public domain: app.barvea.com (SaaS product — CDE/BIM/FM/CMMS panel).
# barvea.com/www.barvea.com PRZEŁĄCZONE 2026-07-28 na osobny CMS biura
# architektonicznego (DNS na innym hostingu) — Caddy/Hetzner już ich nie
# serwuje. www block niżej zostaje jako harmless no-op (redir celuje w
# {uri} na bieżącym DNS barvea.com, więc trafia poprawnie na CMS niezależnie
# od tego czy w ogóle jest wywoływany).
# TLS: auto via Let's Encrypt (HTTP-01 challenge over port 80)
# Backend: app:3005 (Next.js standalone, internal Docker network)
#
# IMPORTANT: For the FIRST deploy, uncomment the staging acme_ca line below
# to avoid hitting Let's Encrypt rate limit (5 issuances/week/domain).
# Once verified, comment it out and reload to issue a real certificate.

{
    email admin@barvea.com
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory   # ← uncomment for first run
    servers {
        protocols h1 h2 h3
        # Behind Cloudflare: trust CF edge so {client_ip} resolves to the real
        # visitor (not the CF 172.64/13 etc. edge IP). Needed for bootstrap_token
        # IP-binding at /devices/enroll. CF ranges from cloudflare.com/ips —
        # refresh if CF publishes new ranges. NOT spoofable: Caddy only trusts
        # X-Forwarded-For from these IPs; a direct-to-origin client's XFF is ignored.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        # CF puts its edge IP in X-Forwarded-For; the real visitor is in
        # Cf-Connecting-Ip. Read {client_ip} from there — only trusted because
        # the request must arrive from a trusted_proxies (CF) hop.
        client_ip_headers Cf-Connecting-Ip
    }
}

# ═══════════════════════════════════════════════════════════════
# app.barvea.com — primary (barvea.com zdjęty 2026-07-28, patrz wyżej)
# ═══════════════════════════════════════════════════════════════
app.barvea.com {
    encode zstd gzip

    # ─── mTLS for Drive client (optional — mode=request) ───
    # Caddy requests but does NOT require a client cert. Browsers that don't
    # present one still complete the TLS handshake normally. Drive client
    # presents a device cert issued by our Vault pki_int; Caddy verifies
    # against root-ca and forwards cert metadata via headers. Per-endpoint
    # enforcement happens in the Next.js app (e.g. /api/v1/devices/* requires
    # presented cert except /enroll which accepts bootstrap_token).
    tls {
        client_auth {
            mode request
            trusted_ca_cert_file /etc/ssl/barvea/root-ca.crt
        }
    }

    # Security headers (centralised here — next.config.ts also sets some;
    # if duplicates appear in browser dev tools, remove from one side)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        # Hide upstream identification
        -Server
        -X-Powered-By
    }

    # ─── Drive machine-to-machine manifests (ACL/WG) — LAN-only ───
    # Served exclusively via app.barvea.internal (WG/LAN). Blocked here on
    # the public vhost as defense-in-depth on top of the bearer-token gate.
    # 404 (not 403) so the paths don't advertise their existence.
    @driveInternal path /api/v1/drive/* /api/v1/orgs/*/drive/*
    handle @driveInternal {
        respond 404
    }

    # ─── Wewnętrzne API współedycji — nigdy z internetu ───
    # barvea-collab woła app:3005 bezpośrednio po sieci docker (barvea_collab);
    # przez Caddy ma być 404 (jak @driveInternal). `path /x/*` NIE łapie gołego
    # `/x` — stąd oba wzorce.
    @collabInternal path /api/v1/internal /api/v1/internal/*
    handle @collabInternal {
        respond 404
    }

    # ─── Współedycja (barvea-collab, WebSocket) ───
    # /_collab — slug organizacji nie może zaczynać się od `_`, brak kolizji
    # z /<orgSlug>. Token idzie w pierwszej wiadomości WS, nie w URL (nie trafia
    # do access.log). Caddy 2 przepuszcza Upgrade: websocket sam.
    @collab path /_collab /_collab/*
    handle @collab {
        uri strip_prefix /_collab
        reverse_proxy collab:1234 {
            # NADPISANIE (nie dopisanie): collab liczy limit gniazd na IP z
            # X-Real-IP; {client_ip} = realny użytkownik (trusted_proxies CF +
            # Cf-Connecting-Ip w opcjach globalnych).
            header_up X-Real-IP {client_ip}
            # caddy reload nie zrywa od razu otwartych gniazd (klienci i tak wznawiają)
            stream_close_delay 5m
            transport http {
                dial_timeout 10s
                # BEZ read/write_timeout — 120 s z catch-all ucinałoby bezczynne
                # gniazda; serwer sam pinguje co 30 s (< ~100 s idle Cloudflare).
            }
        }
    }

    # ─── Signed downloads — CDE files streamed from the data-plane ───
    # /dl/<HMAC-token> — token (TTL 15 min) minted by barvea-datad via
    # GET /signed-download; self-contained, verified by the daemon.
    # Public on purpose: offloads big-file downloads from the app.
    handle /dl/* {
        reverse_proxy 10.10.0.40:8723 {
            flush_interval -1
            transport http {
                # 1800s (bylo 900): 300 MB na laczu komorkowym = kilkanascie minut (Mobile 2026-11-19)
                read_timeout 1800s
                write_timeout 1800s
                dial_timeout 10s
            }
        }
    }

    # ─── Mobile: duże pobierania strumieniowe (modele 3D do 2 GB, dokumenty
    # offline) — catch-all ma write_timeout 120s, wolne łącze komórkowe dostałoby
    # ucięcie w połowie. Range/If-Range obsługuje appka. (odp. Mobile 2026-11-19)
    # Ścieżki od Mobile 2026-11-19 (download dokumentu = 302 na /dl/, ale fallback
    # MinIO strumieniuje przez /api/; preview DWG; zdjęcia do 20 MB na słabym zasięgu;
    # POST-y zdjęć multipart 2–4 min przy 1–2 Mb/s).
    # + …/ifc/{modelId}/file (www, Range/206): model 3D dla osoby z samym PODGLĄDEM
    # katalogu płynie z MinIO przez appkę (handoff API pluginu 2026-11-19 §1.3).
    @mobileStream path /api/v1/mobile/projects/*/models/*/fragments         /api/v1/orgs/*/projects/*/documents/*/download /api/v1/orgs/*/projects/*/documents/*/preview         /api/v1/orgs/*/projects/*/bim-issues/*/attachments /api/v1/orgs/*/projects/*/bim-issues/*/attachments/*         /api/v1/orgs/*/projects/*/daily-log/*/photos /api/v1/orgs/*/projects/*/daily-log/*/photos/*         /api/v1/orgs/*/projects/*/deliveries/*/photos /api/v1/orgs/*/projects/*/deliveries/*/photos/*         /api/v1/orgs/*/projects/*/work-orders/*/photos /api/v1/orgs/*/projects/*/work-orders/*/photos/*         /api/v1/orgs/*/projects/*/ifc/*/file
    handle @mobileStream {
        reverse_proxy app:3005 {
            flush_interval -1
            header_up X-Real-IP {client_ip}
            # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
            header_up -X-Client-Cert-Subject
            header_up -X-Client-Cert-Issuer
            header_up -X-Client-Cert-Serial
            transport http {
                read_timeout 1800s
                write_timeout 1800s
                dial_timeout 10s
            }
        }
    }

    # ─── Plugin: dane uzupełniające OUT-53 (handoff API pluginu 2026-11-19 §1.2) ───
    # init = manifest JSON ≤ 8 MiB, parts = surowy gzip NDJSON ≤ 16 MiB na część
    # (do 64 części, ≤ 4 równolegle). Catch-all nie ma max_size, ale jego 120 s
    # write ucięłoby 16 MiB na wolnym łączu biura. Body gzip idzie SUROWO: Caddy
    # ani CF nie dekodują Content-Encoding żądań; appka liczy sha256 z surowych
    # bajtów (X-Content-SHA256). `complete` (≤ 64 KiB, 202) zostaje na catch-all.
    @pluginAnalytics path /api/v1/plugin/projects/*/element-analytics/init \
        /api/v1/plugin/projects/*/element-analytics/*/parts/*
    handle @pluginAnalytics {
        request_body {
            max_size 17MB
        }
        reverse_proxy app:3005 {
            header_up X-Real-IP {client_ip}
            # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
            header_up -X-Client-Cert-Subject
            header_up -X-Client-Cert-Issuer
            header_up -X-Client-Cert-Serial
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                read_timeout 600s
                write_timeout 600s
                dial_timeout 10s
            }
        }
    }

    # ─── Stripe webhook: needs raw body, generous timeout ───
    handle_path /api/webhooks/* {
        reverse_proxy app:3005 {
            transport http {
                read_timeout 60s
                write_timeout 60s
            }
            header_up X-Real-IP {client_ip}
            # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
            header_up -X-Client-Cert-Subject
            header_up -X-Client-Cert-Issuer
            header_up -X-Client-Cert-Serial
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ─── Long-running server work (small request, long response) ───
    # Finalizacja uploadu kawałkowego (strumień setek GB z tmp na ZFS) i build
    # tomu PDF potrafią liczyć się dziesiątki minut — default 120s je ucinał.
    @longops path \
        /api/v1/orgs/*/projects/*/documents/uploads/*/complete \
        /api/v1/orgs/*/projects/*/volumes/*/build
    handle @longops {
        request_body {
            max_size 10MB
        }
        reverse_proxy app:3005 {
            transport http {
                read_timeout 7200s
                write_timeout 7200s
                dial_timeout 30s
            }
            header_up X-Real-IP {client_ip}
            # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
            header_up -X-Client-Cert-Subject
            header_up -X-Client-Cert-Issuer
            header_up -X-Client-Cert-Serial
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ─── Large file uploads (single-POST ≤1 GB; chunked = 32 MB per request) ───
    # UWAGA: Caddy `path /foo/*` NIE łapie gołego `/foo` — a upload CDE leci
    # POST-em na goły `.../documents`, upload IFC na goły `.../ifc`. Przez ten
    # brak requesty wpadały do domyślnego handlera z timeoutem 120 s i duże
    # pliki na wolniejszym łączu były ucinane w połowie body (Firefox:
    # "NetworkError when attempting to fetch resource").
    # `*` łapie JEDEN segment ścieżki — chunk PUT (…/documents/uploads/<id>)
    # ma dwa segmenty po /documents i potrzebuje własnego wzorca.
    @uploads path \
        /api/v1/orgs/*/projects/*/documents \
        /api/v1/orgs/*/projects/*/documents/* \
        /api/v1/orgs/*/projects/*/documents/uploads/* \
        /api/v1/orgs/*/projects/*/ifc \
        /api/v1/orgs/*/projects/*/ifc/* \
        /api/v1/orgs/*/projects/*/assets/*/documents \
        /api/v1/orgs/*/projects/*/combined-models* \
        /api/v1/plugin/projects/*/cde/upload \
        /api/v1/plugin/projects/*/ifc-upload
    handle @uploads {
        request_body {
            max_size 1GB
        }
        reverse_proxy app:3005 {
            transport http {
                read_timeout 600s
                write_timeout 600s
                dial_timeout 30s
            }
            header_up X-Real-IP {client_ip}
            # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
            header_up -X-Client-Cert-Subject
            header_up -X-Client-Cert-Issuer
            header_up -X-Client-Cert-Serial
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ─── Healthcheck: exposed without rate limit (for monitoring) ───
    handle /api/health {
        reverse_proxy app:3005 {
            # spójność: X-Real-IP = {client_ip} na KAŻDEJ trasie do app (mobile 10.2026)
            header_up X-Real-IP {client_ip}
            # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
            header_up -X-Client-Cert-Subject
            header_up -X-Client-Cert-Issuer
            header_up -X-Client-Cert-Serial
            transport http {
                read_timeout 10s
            }
        }
    }

    # ─── Static + everything else ───
    handle {
        # Cache Next.js immutable assets aggressively
        @nextStatic path /_next/static/*
        header @nextStatic Cache-Control "public, max-age=31536000, immutable"

        @publicStatic path /public/*
        header @publicStatic Cache-Control "public, max-age=86400"

        reverse_proxy app:3005 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}

            # mTLS cert metadata (empty if client didn't present a cert)
            header_up X-Client-Cert-Subject {tls_client_subject}
            header_up X-Client-Cert-Issuer {tls_client_issuer}
            header_up X-Client-Cert-Serial {tls_client_serial}

            # Sensible timeouts for non-upload traffic
            transport http {
                read_timeout 120s
                write_timeout 120s
                dial_timeout 10s
            }
        }
    }

    # ─── Logging ───
    log {
        output file /data/access.log {
            roll_size 100MiB
            roll_keep 14
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

# ═══════════════════════════════════════════════════════════════
# Internal WG-direct endpoint — Drive device API (sessions/start,
# policy, cde, audit). Reached ONLY over the wg-users tunnel.
# Client resolves app.barvea.internal -> 10.10.0.30 (hosts entry or
# ConnectCallback) and dials it over WG; Caddy matches on SNI.
# NOTE: do NOT add the bare IP (https://10.10.0.30) as a site address
# here — Caddy's automatic HTTPS chokes on a bare-IP site and breaks
# TLS for the whole block (tlsv1 alert internal error). Hostname only.
# Serves our pki_int cert (chains to BARVEA Root CA) so the Drive
# client's Root-CA SPKI pin matches; device mTLS forwarded, enforced
# per-endpoint in app.
# ═══════════════════════════════════════════════════════════════
https://app.barvea.internal {
    tls /etc/ssl/barvea/internal.crt /etc/ssl/barvea/internal.key {
        client_auth {
            mode request
            trusted_ca_cert_file /etc/ssl/barvea/root-ca.crt
        }
    }
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
        -X-Powered-By
    }
    # Wewnętrzne API współedycji — 404 także od strony WG/LAN (collab woła app
    # po sieci docker). `respond` ma wyższy priorytet niż reverse_proxy.
    # /_collab tu celowo NIE ma: współedycja tylko przez app.barvea.com
    # (COLLAB_ALLOWED_ORIGINS); zmiana = decyzja APP + dopisanie originu.
    @collabInternal path /api/v1/internal /api/v1/internal/*
    respond @collabInternal 404
    reverse_proxy app:3005 {
        header_up X-Real-IP {client_ip}
        header_up Host {host}
        header_up X-Client-Cert-Subject {tls_client_subject}
        header_up X-Client-Cert-Issuer {tls_client_issuer}
        header_up X-Client-Cert-Serial {tls_client_serial}
        transport http {
            read_timeout 120s
            write_timeout 120s
            dial_timeout 10s
        }
    }
    log {
        output file /data/access-internal.log {
            roll_size 50MiB
            roll_keep 7
        }
        format json
    }
}

# ═══════════════════════════════════════════════════════════════
# www.barvea.com — 301 redirect to apex
# ═══════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════
# Panel administratora platformy — admin.barvea.com (APP 2026-11-23, decyzja Miko:
# TEN SAM kontener app, osobny host, publicznie za Cloudflare, bez Access).
# Aplikacja rozpoznaje panel po nagłówku Host (ADMIN_HOST w .env.production); do
# czasu ustawienia ADMIN_HOST host odpowiada jak zwykła appka. Po włączeniu: tu
# tylko /admin, /api/v1/admin, logowanie + 2FA za każdym razem (bez zaufanej
# przeglądarki), sesja 30 min bezczynności (Redis), reszta 404/redirect na app.
# Bez mTLS (Drive tu nie wchodzi), bez tras upload/stream (panel = małe JSON-y).
# TLS: automatyczny (ACME) jak app.barvea.com — rekord DNS musi istnieć PRZED reloadem.
# ═══════════════════════════════════════════════════════════════
admin.barvea.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Cross-Origin-Opener-Policy "same-origin"
        -Server
        -X-Powered-By
    }

    # Trasy wewnętrzne i Drive nigdy pod hostem panelu (defense-in-depth; appka i tak 404-uje).
    @notForAdmin path /api/v1/internal /api/v1/internal/* /api/v1/drive/* /api/v1/orgs/*/drive/* /_collab /_collab/* /dl/* \
        /api/v1/devices /api/v1/devices/* /api/v1/sessions /api/v1/sessions/* /api/v1/plugin /api/v1/plugin/* /api/v1/mobile /api/v1/mobile/*
    respond @notForAdmin 404

    # Największe ciało pod panelem = kawałek wydania instalatora (8 MB, serwer do 16 MB)
    # i medium CMS 10 MB (APP 2026-11-23). Reszta = małe JSON-y.
    request_body {
        max_size 20MB
    }

    reverse_proxy app:3005 {
        header_up X-Real-IP {client_ip}
        # Nagłówki tożsamości mTLS tylko z TLS (catch-all/internal); tu zdejmij, co przysłał klient.
        header_up -X-Client-Cert-Subject
        header_up -X-Client-Cert-Issuer
        header_up -X-Client-Cert-Serial
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
        transport http {
            read_timeout 120s
            write_timeout 120s
            dial_timeout 10s
        }
    }

    log {
        output file /data/admin-access.log {
            roll_size 50MiB
            roll_keep 14
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

www.barvea.com {
    redir https://barvea.com{uri} 301
}
