# BARVEA — .env.production TEMPLATE (nazwy zmiennych, BEZ wartości)
# ═══════════════════════════════════════════════════════════════════
# ⚠️ KEEP IN SYNC — to jest ŻYWY dokument. Zsynchronizowany z prod: 2026-07-09
# Za KAŻDYM razem gdy APP/infra doda nową zmienną do .env.production →
# DOPISZ ją tutaj (bez wartości). Rozjazd = nowa instancja nie wstanie.
# Weryfikacja rozjazdu: `grep -oE '^[A-Z_]+=' .env.production | sort` vs ten plik.
# ═══════════════════════════════════════════════════════════════════
# Sekrety (oznaczone 🔑) generować per-instancja; NIGDY nie commitować wartości.
# Dla dedyk on-prem: część zmiennych inna (patrz input/DEDYK-DEPLOYMENT-SPEC.md).

# ── App core ──
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_REPO_URL=            # git repo aplikacji (deploy.sh pull)
APP_REPO_BRANCH=main

# ── Auth (NextAuth v5) 🔑 ──
AUTH_SECRET=             # 🔑 openssl rand -hex 32
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=         # 🔑
NEXTAUTH_URL=            # https://<domena instancji>

# ── Public URLs ──
NEXT_PUBLIC_APP_URL=     # https://<domena>
NEXT_PUBLIC_SOCKET_URL=  # wss://<domena> lub :3001

# ── DB / cache ──
DATABASE_URL=            # 🔑 postgres conn string (barvea-data)
REDIS_URL=               # redis://barvea-data:6379

# ── MinIO (S3) 🔑 ──
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=        # 🔑
MINIO_SECRET_KEY=        # 🔑
MINIO_BUCKET_ASSETS=
MINIO_BUCKET_DOCS=
MINIO_BUCKET_IFC=
MINIO_BUCKET_QR=
MINIO_BUCKET_REPORTS=

# ── Vault (KMS/PKI/transit) 🔑 ──
VAULT_ENDPOINT=          # https://10.10.0.50:8200
VAULT_STRICT_SSL=false   # internal CA
VAULT_APPROLE_ROLE_ID=   # 🔑 barvea-app AppRole
VAULT_APPROLE_SECRET_ID= # 🔑
BARVEA_INTERMEDIATE_CA_CN=BARVEA Intermediate CA
UNWRAP_TOKEN_PRIVATE_KEY_PEM=  # 🔑 ES256 (\n-escaped)
UNWRAP_TOKEN_PUBLIC_KEY_PEM=   # ES256 pub

# ── Drive: core ──
DRIVE_NAMED_PATHS=1            # named folder paths (nie cuid)
DRIVE_SMB_HOST=drive.barvea.internal   # hostname (NIE bare IP — Revit-proof)

# ── Drive: data-plane (barvea-datad :8723) 🔑 ──
DRIVE_DATA_URL=http://10.10.0.40:8723
DRIVE_DATA_TOKEN=        # 🔑 = TOKEN z /etc/barvea/barvea-datad.env

# ── Drive: ACL manifest puller 🔑 ──
DRIVE_ACL_SERVICE_TOKEN= # 🔑

# ── Drive: SMB user provisioning (smb-provisiond :8722) 🔑 ──
DRIVE_SMB_PROVISION_URL=http://10.10.0.40:8722
DRIVE_SMB_PROVISION_TOKEN=  # 🔑

# ── Drive: WG control-plane + client config 🔑 ──
DRIVE_WG_PROVISION_URL=http://10.10.0.10:8721
DRIVE_WG_PROVISION_TOKEN=   # 🔑
DRIVE_WG_MANIFEST_TOKEN=    # 🔑 (reconciler, gdy powstanie)
DRIVE_WG_ALLOWED_IPS=10.10.0.30/32,10.10.0.40/32,10.67.0.1/32
DRIVE_WG_DNS=
DRIVE_WG_ENDPOINT=          # <public>:51821
DRIVE_WG_SERVER_PUBKEY=     # wg-users server pubkey
DRIVE_WS_ENDPOINT=          # Sprint 3 (instant revoke)

# ── Email (SMTP/Resend) 🔑 ──
FROM_EMAIL=
FROM_NAME=BARVEA
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=               # 🔑
SMTP_PASS=               # 🔑

# ── Payments (SaaS only — dedyk: OFF przez DEPLOYMENT_MODE) 🔑 ──
STRIPE_SECRET_KEY=       # 🔑
STRIPE_WEBHOOK_SECRET=   # 🔑

# ── (przyszłe, dedyk — do dodania) ──
# DEPLOYMENT_MODE=dedicated|saas   # trim www + billing off (spec)
# LICENSE_FILE / LICENSE_PUBLIC_KEY  # Ed25519 signed license (spec)
