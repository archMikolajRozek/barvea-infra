# BARVEA — .env.production TEMPLATE (nazwy zmiennych, BEZ wartości)
# ═══════════════════════════════════════════════════════════════════
# ⚠️ KEEP IN SYNC — to jest ŻYWY dokument. Zsynchronizowany z prod: 2026-07-09
# Za KAŻDYM razem gdy APP/infra doda nową zmienną do .env.production →
# DOPISZ ją tutaj (bez wartości). Rozjazd = nowa instancja nie wstanie.
# Weryfikacja rozjazdu: `grep -oE '^[A-Z_]+=' .env.production | sort` vs ten plik.
# ═══════════════════════════════════════════════════════════════════
# Sekrety (oznaczone 🔑) generować per-instancja; NIGDY nie commitować wartości.
# Dla dedyk on-prem: część zmiennych inna (patrz input/DEDYK-DEPLOYMENT-SPEC.md).

# ── App core ──
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_REPO_URL=            # git repo aplikacji (deploy.sh pull)
APP_REPO_BRANCH=main

# ── Auth (NextAuth v5) 🔑 ──
AUTH_SECRET=             # 🔑 openssl rand -hex 32
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=         # 🔑
NEXTAUTH_URL=            # https://<domena instancji>

# ── Public URLs ──
NEXT_PUBLIC_APP_URL=     # https://<domena>
NEXT_PUBLIC_SOCKET_URL=  # wss://<domena> lub :3001

# ── DB / cache ──
DATABASE_URL=            # 🔑 postgres conn string (barvea-data)
REDIS_URL=               # redis://barvea-data:6379

# ── MinIO (S3) 🔑 ──
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=        # 🔑
MINIO_SECRET_KEY=        # 🔑
MINIO_BUCKET_ASSETS=
MINIO_BUCKET_DOCS=
MINIO_BUCKET_IFC=
MINIO_BUCKET_QR=
MINIO_BUCKET_REPORTS=

# ── Vault (KMS/PKI/transit) 🔑 ──
VAULT_ENDPOINT=          # https://10.10.0.50:8200
VAULT_STRICT_SSL=false   # internal CA
VAULT_APPROLE_ROLE_ID=   # 🔑 barvea-app AppRole
VAULT_APPROLE_SECRET_ID= # 🔑
BARVEA_INTERMEDIATE_CA_CN=BARVEA Intermediate CA
UNWRAP_TOKEN_PRIVATE_KEY_PEM=  # 🔑 ES256 (\n-escaped)
UNWRAP_TOKEN_PUBLIC_KEY_PEM=   # ES256 pub

# ── Drive: core ──
DRIVE_NAMED_PATHS=1            # named folder paths (nie cuid)
DRIVE_SMB_HOST=drive.barvea.internal   # hostname (NIE bare IP — Revit-proof)

# ── Drive: data-plane (barvea-datad :8723) 🔑 ──
DRIVE_DATA_URL=http://10.10.0.40:8723
DRIVE_DATA_TOKEN=        # 🔑 = TOKEN z /etc/barvea/barvea-datad.env
# Limit POJEDYNCZEGO pliku po stronie aplikacji (default w kodzie: 2 GB).
# MUSI iść w parze z MAX_UPLOAD_GB w /etc/barvea/barvea-datad.env — niższa
# z dwóch wartości wygrywa. Podnosząc, sprawdź miejsce na /srv/upload-tmp
# (VM 102): aplikacja skleja tam CAŁY plik przed wysłaniem do datad.
# 53687091200 = 50 GB
DRIVE_MAX_FILE_BYTES=

# ── Antywirus (clamd na LXC 201, storage/clamav/README.md) ──
# Brak AV_CLAMD_HOST / AV_MODE=off = moduł ciemny. Tryby: warn → block.
AV_CLAMD_HOST=10.10.0.40
AV_CLAMD_PORT=3310
AV_MODE=block                  # prod: block od 2026-10-23 (warn = tylko raport)
AV_REQUIRED=0                  # 1 = fail-closed (odrzucaj uploady gdy clamd leży)
AV_MAX_BYTES=2147483648        # = StreamMaxLength/MaxFileSize w clamd.conf (2100M)
AV_DRIVE_MOUNT=/srv/orgs       # ścieżka W LXC 201 (tam działa clamd), nie w kontenerze app
AV_DRIVE_PATH_TEMPLATE={mount}/{orgId}/{path}

# ── Współedycja (barvea-collab) 🔑 — serwer/BARVEA_COLLAB_INFRA_HANDOFF.md §5 ──
# Generowanie: cd ~/barvea/app && docker run --rm -v "$PWD/scripts:/s:ro" node:24.12.0-alpine node /s/collab-keys.mjs
# Appka włącza współedycję TYLKO przy komplecie PUBLIC_URL+INTERNAL_URL+SERVICE_TOKEN+JWT_PRIVATE_KEY;
# brak któregokolwiek = tryb jednego edytora. Collab dostaje tylko SERVICE_TOKEN + JWT_PUBLIC_KEY
# (interpolacja w compose). PEM-y w jednej linii z \n w cudzysłowach (compose rozwija \n).
COLLAB_PUBLIC_URL=wss://app.barvea.com/_collab
COLLAB_SERVICE_TOKEN=          # 🔑 64 hex
COLLAB_JWT_PRIVATE_KEY=        # 🔑 Ed25519 PKCS#8 — TYLKO app
COLLAB_JWT_PUBLIC_KEY=         # 🔑 Ed25519 SPKI — app + collab
# COLLAB_INTERNAL_URL — w environment usługi app w docker-compose.yml (http://collab:1235)

# ── Push mobilny (M3) 🔑 — serwer/INFRA_HANDOFF_MOBILE_2026-10-29.md §7 ──
# Service account Firebase jako CAŁY JSON w jednej linii, w POJEDYNCZYCH cudzysłowach
# (w podwójnych compose rozwinąłby 
 z private_key i JSON by się rozsypał).
# Transfer na serwer: pscp -i klucz.ppk (klucz nigdy przez czat/schowek), potem
# tr -d '
' < plik >> .env.production i shred -u pliku. Brak = push wyłączony.
FCM_SERVICE_ACCOUNT_JSON=      # 🔑 '{"type":"service_account",...}'
APNS_KEY_P8=                   # 🔑 PEM w jednej linii z 
 (jak COLLAB_JWT_*)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ── Drive: ACL manifest puller 🔑 ──
DRIVE_ACL_SERVICE_TOKEN= # 🔑

# ── Drive: SMB user provisioning (smb-provisiond :8722) 🔑 ──
DRIVE_SMB_PROVISION_URL=http://10.10.0.40:8722
DRIVE_SMB_PROVISION_TOKEN=  # 🔑

# ── Drive: WG control-plane + client config 🔑 ──
DRIVE_WG_PROVISION_URL=http://10.10.0.10:8721
DRIVE_WG_PROVISION_TOKEN=   # 🔑
DRIVE_WG_MANIFEST_TOKEN=    # 🔑 (reconciler, gdy powstanie)
DRIVE_WG_ALLOWED_IPS=10.10.0.30/32,10.10.0.40/32,10.67.0.1/32
DRIVE_WG_DNS=
DRIVE_WG_ENDPOINT=          # <public>:51821
DRIVE_WG_SERVER_PUBKEY=     # wg-users server pubkey
DRIVE_WS_ENDPOINT=          # Sprint 3 (instant revoke)

# ── Email (SMTP/Resend) 🔑 ──
FROM_EMAIL=
FROM_NAME=BARVEA
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=               # 🔑
SMTP_PASS=               # 🔑

# ── Payments (SaaS only — dedyk: OFF przez DEPLOYMENT_MODE) 🔑 ──
STRIPE_SECRET_KEY=       # 🔑
STRIPE_WEBHOOK_SECRET=   # 🔑

# ── (przyszłe, dedyk — do dodania) ──
# DEPLOYMENT_MODE=dedicated|saas   # trim www + billing off (spec)
# LICENSE_FILE / LICENSE_PUBLIC_KEY  # Ed25519 signed license (spec)

# ── Etap 2 bezpieczeństwo (handoff APP 2026-11-23) ──
# CSP: report (domyślnie) → enforce po 2 dniach czystych raportów (panel Błędy systemu → csp); wycofanie = report + recreate app.
CSP_MODE=report
# Sekrety 2FA szyfrowane w bazie: base64 z 32 bajtów (openssl rand -base64 32), generowany NA SERWERZE.
# Kolejność: klucz → recreate app → pg_dump → scripts/encrypt-totp-secrets.ts --dry-run → bez --dry-run.
# UTRATA KLUCZA = reset 2FA wszystkim użytkownikom (klucz jest w restic VM 102 razem z .env.production).
TOTP_ENCRYPTION_KEY=            # 🔑

# ── Konta Samby per (użytkownik, org) — APP 124618c0, strumień S1 (INSTALATOR-PLAN-2026-11.md §4) ──
# Pusty = stare konta per użytkownik (prod do okna migracji). `per-org` = nowe konta u_<10>_<10> z manifestem
# i should_reconnect — ustawiać TYLKO w oknie migracji po smb-provisiond v2 + chown plików.
DRIVE_SMB_ACCOUNTS=

# ── Dowód mTLS Caddy → app (APP 2026-11-23, lib/mtls.ts; po wycieku-scenariuszu spoofu X-Client-Cert-*) 🔑 ──
# openssl rand -hex 32, generowany NA SERWERZE. Caddy dokłada X-Barvea-Mtls-Proof tylko tam, gdzie sam ustawia
# X-Client-Cert-* z TLS; app przyjmuje nagłówki certyfikatu wyłącznie z poprawnym dowodem. Kolejność bez przerwy:
# zmienna w .env.production → recreate caddy (kilka sekund przerwy CAŁEGO ruchu) → (po deployu kodu) recreate app.
MTLS_PROXY_SECRET=              # 🔑 64 hex

# ── Panel administratora na osobnym hoście (APP 2026-11-23; Caddy blok admin.barvea.com) ──
# Bez ADMIN_HOST panel = app.barvea.com/admin jak dotąd. Po ustawieniu: panel TYLKO pod tym hostem,
# /api/v1/admin pod app → 404, osobna sesja, 2FA przy każdym logowaniu, bezczynność ADMIN_SESSION_IDLE_MIN (5–240).
# Wycofanie = usunąć zmienną + recreate app. Wymaga: DNS admin.barvea.com (CF proxy) + Turnstile domena (jeśli włączony).
# ADMIN_HOST=admin.barvea.com
# ADMIN_SESSION_IDLE_MIN=30

# ── Kolizje IFC + kalibracja OUT-53 (sidecar ifc-clash, K1 2026-11) 🔑 ──
# openssl rand -hex 32. App czyta przez env_file, sidecar dostaje TYLKO tę zmienną
# (interpolacja ${IFC_CLASH_TOKEN:-} w compose). Pusty = sidecar odrzuca wszystko (503).
# IFC_CLASH_URL ustawia docker-compose.yml (http://ifc-clash:8080); bez niego moduł ciemny.
IFC_CLASH_TOKEN=                # 🔑 64 hex
# Zestawienia IFC (sidecar ifc-extractor, 2026-11): ten sam wzorzec; IFC_EXTRACTOR_URL z compose.
IFC_EXTRACTOR_TOKEN=            # 🔑 64 hex
# Bramka wersji pluginów (APP, przebieg 2 2026-11-20): per program; brak → stare PLUGIN_MIN_VERSION/PLUGIN_LATEST_VERSION;
# "0.0.0" = jawnie wyłączone. Ustawiać dopiero po wydaniu pluginu z twardą bramką 426 (Revit: 1.0.0).
# PLUGIN_MIN_VERSION_REVIT=        PLUGIN_LATEST_VERSION_REVIT=
# PLUGIN_MIN_VERSION_AUTOCAD=      PLUGIN_LATEST_VERSION_AUTOCAD=
# Opcjonalne (app): CLASH_MAX_RESULTS=100000  CLASH_MAX_SIDE_ELEMENTS=300000  IFC_PARSE_HEAP_MB=3072
# MinIO publiczny endpoint (MINIO_PUBLIC_ENDPOINT/_PORT/_USE_SSL) CELOWO NIEUSTAWIONY:
# MinIO jest tylko w LAN VM-ów; pliki/raporty idą przez appkę (/api, /dl), nie linkiem do MinIO.

