# ═══════════════════════════════════════════════════════════════
# BARVEA production env — VM barvea-app (10.10.0.30)
# ═══════════════════════════════════════════════════════════════
# Generate strong secrets:
#   openssl rand -base64 32   # for *_PASSWORD / SECRET_KEY
#   openssl rand -base64 64   # for NEXTAUTH_SECRET
#
# Copy this file: cp .env.production.example .env.production
# Then fill placeholders. chmod 600 .env.production.
# ═══════════════════════════════════════════════════════════════

# ─── Runtime ───
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ─── Public URLs (used in emails, OAuth callbacks, Socket.io) ───
NEXT_PUBLIC_APP_URL=https://barvea.com
NEXT_PUBLIC_SOCKET_URL=https://barvea.com

# ─── PostgreSQL (native on barvea-data 10.10.0.20:5432) ───
# User barvea_app has RW only on database `barvea`. scram-sha-256 auth.
# Schema must already have extensions: postgis, postgis_topology, pg_trgm, pgcrypto, uuid-ossp
DATABASE_URL=postgresql://barvea_app:__BARVEA_APP_DB_PASSWORD__@10.10.0.20:5432/barvea?schema=public&sslmode=disable&connection_limit=20&pool_timeout=10

# ─── Redis (native on barvea-data 10.10.0.20:6379, requirepass on) ───
REDIS_URL=redis://default:__REDIS_PASSWORD__@10.10.0.20:6379

# ─── MinIO (native on barvea-data 10.10.0.20:9000) ───
MINIO_ENDPOINT=10.10.0.20
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=barvea_app_minio
MINIO_SECRET_KEY=__MINIO_APP_SECRET_KEY__

# Buckets — code expects 5 separate buckets. Create them on barvea-data with
# the same `barvea_app_minio` policy attached, all with versioning enabled.
MINIO_BUCKET_IFC=barvea-ifc
MINIO_BUCKET_DOCS=barvea-docs
MINIO_BUCKET_ASSETS=barvea-assets
MINIO_BUCKET_QR=barvea-qr
MINIO_BUCKET_REPORTS=barvea-reports

# ─── NextAuth v5 ───
# Trust forwarded host header (Caddy is in front)
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://barvea.com
NEXTAUTH_SECRET=__GENERATE_64_CHAR_BASE64_SECRET__

# ─── SMTP (transactional email) ───
# Provider: dpoczta.pl (default in code), Resend (manual switch), Postmark, etc.
SMTP_HOST=smtp.dpoczta.pl
SMTP_PORT=587
SMTP_USER=__SMTP_USER__
SMTP_PASS=__SMTP_PASSWORD__
FROM_NAME=BARVEA
FROM_EMAIL=noreply@barvea.com

# ─── Stripe (billing) ───
# Get from https://dashboard.stripe.com/apikeys (live mode after launch)
STRIPE_SECRET_KEY=sk_live___YOUR_KEY__
# Webhook endpoint registered at https://dashboard.stripe.com/webhooks
# Endpoint URL: https://barvea.com/api/webhooks/stripe
# Events to subscribe: checkout.session.completed, customer.subscription.updated/deleted,
#                     invoice.created, invoice.finalized, invoice.paid, invoice.payment_failed, invoice.voided
STRIPE_WEBHOOK_SECRET=whsec___YOUR_WEBHOOK_SIGNING_SECRET__

# ─── App repo (used by deploy.sh) ───
APP_REPO_URL=git@github.com:archMikolajRozek/barvea.git
APP_REPO_BRANCH=main
